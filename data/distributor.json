{
  "id": "harbor-mutual-demo",
  "name": "Harbor Mutual Demo Group",
  "market": "synthetic personal and small-commercial insurance distribution",
  "jurisdictions": ["CA", "TX", "NY", "UK-DEMO"],
  "reviewPolicy": {
    "licensedReviewRequired": true,
    "blockedActions": ["quoting", "binding", "insurance-advice", "product-selection", "eligibility-decision", "real-outreach", "credential-collection", "regulated-selling"],
    "approvalRoles": ["licensed-producer", "compliance-reviewer"]
  },
  "channels": [
    {
      "id": "web-chat",
      "label": "Website chat assistant",
      "mode": "chat",
      "allowedIntents": ["intake", "consent-check", "handoff"]
    },
    {
      "id": "email-nurture",
      "label": "Email nurture drafts",
      "mode": "email",
      "allowedIntents": ["appointment-setting", "status-reminder"]
    },
    {
      "id": "partner-portal",
      "label": "Partner portal inbox",
      "mode": "portal",
      "allowedIntents": ["intake", "status-update", "handoff"]
    },
    {
      "id": "agent-assist",
      "label": "Licensed agent assist",
      "mode": "internal",
      "allowedIntents": ["summary", "task-routing", "script-qa", "compliance-review"]
    },
    {
      "id": "carrier-style-sandbox",
      "label": "Carrier-style sandbox queue",
      "mode": "carrier-style",
      "allowedIntents": ["handoff-summary", "status-mirror", "document-request-placeholder"]
    }
  ],
  "roles": [
    {
      "id": "sales-ops",
      "label": "Sales operations",
      "canApproveRegulatedLanguage": false,
      "canSendMockedOutreach": true
    },
    {
      "id": "licensed-producer",
      "label": "Licensed producer",
      "canApproveRegulatedLanguage": true,
      "canSendMockedOutreach": true
    },
    {
      "id": "compliance-reviewer",
      "label": "Compliance reviewer",
      "canApproveRegulatedLanguage": true,
      "canSendMockedOutreach": false
    }
  ]
}
